# 빌드 컨텍스트는 레포 루트 (npm workspaces라 루트 package-lock.json 기준으로 설치)
FROM node:22-bookworm-slim AS base
# Prisma 쿼리 엔진이 openssl을 필요로 함
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/cron/package.json apps/cron/
RUN npm ci -w web --include-workspace-root

FROM deps AS build
# 호스트(Windows)에서 만든 엔진은 못 쓰므로 리눅스용으로 다시 생성
COPY prisma ./prisma
RUN npx prisma generate
COPY apps/web ./apps/web
RUN npm run build -w web

FROM base AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# standalone 출력은 outputFileTracingRoot(레포 루트) 기준이라 server.js가 apps/web/ 아래에 생김
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
