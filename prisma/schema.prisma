generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrendSource {
  GOOGLE_TRENDS
  YOUTUBE
  NAVER_DATALAB
}

enum CollectionStatus {
  SUCCESS
  FAILED
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  createdAt DateTime    @default(now())
  trendItems TrendItem[]
}

model TrendItem {
  id          String      @id @default(cuid())
  title       String
  source      TrendSource
  sourceUrl   String?
  score       Float?
  rawData     Json?
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  aiSummary   AiSummary?
  collectedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())

  // YouTube 영상 반복 추적용 (source=YOUTUBE에서만 값이 채워짐)
  youtubeVideoId    String?  @unique
  channelId         String?
  channelTitle      String?
  subscriberCount   Int?
  isOfficialChannel Boolean  @default(false)
  velocityScore     Float?

  snapshots     VideoSnapshot[]
  videoKeywords VideoKeyword[]

  @@index([source, collectedAt])
  @@index([categoryId])
}

model VideoSnapshot {
  id          String    @id @default(cuid())
  trendItem   TrendItem @relation(fields: [trendItemId], references: [id], onDelete: Cascade)
  trendItemId String
  viewCount   Int
  capturedAt  DateTime  @default(now())

  @@index([trendItemId, capturedAt])
}

model Keyword {
  id            String         @id @default(cuid())
  text          String         @unique
  videoKeywords VideoKeyword[]
  createdAt     DateTime       @default(now())
}

model VideoKeyword {
  id          String    @id @default(cuid())
  trendItem   TrendItem @relation(fields: [trendItemId], references: [id], onDelete: Cascade)
  trendItemId String
  keyword     Keyword   @relation(fields: [keywordId], references: [id])
  keywordId   String
  createdAt   DateTime  @default(now())

  @@unique([trendItemId, keywordId])
}

model AiSummary {
  id            String    @id @default(cuid())
  trendItem     TrendItem @relation(fields: [trendItemId], references: [id], onDelete: Cascade)
  trendItemId   String    @unique
  summary       String
  model         String    @default("gemini-flash")
  promptVersion String    @default("v1")
  createdAt     DateTime  @default(now())
}

model CollectionLog {
  id             String            @id @default(cuid())
  source         TrendSource
  status         CollectionStatus
  itemsCollected Int               @default(0)
  errorMessage   String?
  startedAt      DateTime
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([source, createdAt])
}
