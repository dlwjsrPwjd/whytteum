# 호스트에서 실행할 때(npm run dev / collect)의 DB 주소. docker compose(프로덕션)에서는 db 컨테이너 주소로 자동으로 덮어씀
DATABASE_URL=postgresql://user:password@localhost:5432/whytteum
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
YOUTUBE_API_KEY=
NEXT_PUBLIC_APP_URL=

# docker compose(프로덕션) 전용 — 비우면 기본값 사용
# 수집 주기(초). 유튜브 탐색은 이 값과 무관하게 코드에서 4시간 간격으로만 실행
COLLECT_INTERVAL_SECONDS=3600
# 웹 포트 (개발 서버가 3000을 쓰고 있으면 3001 등으로)
WEB_PORT=3000
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=whytteum
